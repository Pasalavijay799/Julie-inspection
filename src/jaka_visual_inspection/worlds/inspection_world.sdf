<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="jaka_inspection_world">

    <!-- Physics — ODE max_contacts limits contact points per pair,
         suppresses "Trimesh-trimesh hash table bucket overflow" warning -->
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <ode>
        <solver>
          <type>quick</type>
        </solver>
        <constraints>
          <contact_max_correcting_vel>100</contact_max_correcting_vel>
          <contact_surface_layer>0.001</contact_surface_layer>
        </constraints>
      </ode>
      <max_contacts>4</max_contacts>
    </physics>

    <!-- Plugins -->
    <plugin filename="libignition-gazebo-physics-system.so"
            name="ignition::gazebo::systems::Physics"/>
    <plugin filename="libignition-gazebo-user-commands-system.so"
            name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="libignition-gazebo-scene-broadcaster-system.so"
            name="ignition::gazebo::systems::SceneBroadcaster"/>
    <plugin filename="libignition-gazebo-sensors-system.so"
            name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="libignition-gazebo-contact-system.so"
            name="ignition::gazebo::systems::Contact"/>

    <!-- Lighting -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Ground Plane -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Robot Stand (775x775x790 mm CAD → scale 0.001 → 0.775x0.775x0.79 m) -->
    <!--
      The STL origin is at the bottom-left corner of the stand.
      We centre it at X=0, Y=0 and sit it on the ground (Z=0).
      Offset X and Y by -0.3875 m (half of 0.775 m) to centre the mesh.
    -->
    <model name="robot_stand">
      <static>true</static>
      <pose>-0.3875 0.3875 0.790 3.14159 0 0</pose>
      <link name="stand_link">
        <collision name="collision">
          <geometry>
            <mesh>
              <uri>file:///home/julie/Music/Julie-inspection/src/jaka_visual_inspection/meshes/robot_stand.stl</uri>
              <scale>0.001 0.001 0.001</scale>
            </mesh>
          </geometry>
        </collision>
        <!-- Full STL visual kept unchanged -->
        <visual name="visual">
          <geometry>
            <mesh>
              <uri>file:///home/julie/Music/Julie-inspection/src/jaka_visual_inspection/meshes/robot_stand.stl</uri>
              <scale>0.001 0.001 0.001</scale>
            </mesh>
          </geometry>
          <material>
            <ambient>0.4 0.4 0.4 1</ambient>
            <diffuse>0.5 0.5 0.5 1</diffuse>
            <specular>0.3 0.3 0.3 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- ZED 2i camera body only — 170x40x40mm at X=0.90 Y=0.90 Z=1.50m
         Tilted 60° down, facing the robot workspace from the corner. -->
    <model name="zed2i_mount">
      <static>true</static>
      <pose>0.90 0.90 1.50 0 -1.047 -2.356</pose>
      <link name="camera_body">
        <visual name="camera_visual">
          <geometry>
            <box>
              <size>0.17 0.04 0.04</size>
            </box>
          </geometry>
          <material>
            <ambient>0.08 0.08 0.08 1</ambient>
            <diffuse>0.12 0.12 0.12 1</diffuse>
            <specular>0.5 0.5 0.5 1</specular>
          </material>
        </visual>
      </link>
    </model>


  </world>
</sdf>
