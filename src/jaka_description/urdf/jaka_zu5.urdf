    <!-- ==================== Intel RealSense D435 Camera ==================== -->

    <!-- Camera mount bracket (clamps onto Link_6 cylinder, holds camera above) -->
    <link name="camera_mount_link">
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="0.15"/>
        <inertia ixx="0.0001" iyy="0.0001" izz="0.0001" ixy="0.0" iyz="0.0" ixz="0.0"/>
      </inertial>
      <visual>
        <origin xyz="0.0335 -0.08 -0.005" rpy="1.5708 0 3.14159"/>
        <geometry>
          <mesh filename="package://jaka_description/meshes/onrobot_2fg7_meshes/camera_mount.stl" scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="mount_red">
          <color rgba="0.7 0.2 0.2 1.0"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0.0335 -0.08 -0.005" rpy="1.5708 0 3.14159"/>
        <geometry>
          <mesh filename="package://jaka_description/meshes/onrobot_2fg7_meshes/camera_mount.stl" scale="0.001 0.001 0.001"/>
        </geometry>
      </collision>
    </link>

    <!-- Camera body link (Intel RealSense D435: 90mm x 25mm x 25mm) -->
    <link name="camera_link">
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="0.072"/>
        <inertia ixx="0.00004" iyy="0.00004" izz="0.00004" ixy="0.0" iyz="0.0" ixz="0.0"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="0.025 0.025 0.09"/>
        </geometry>
        <material name="camera_grey">
          <color rgba="0.5 0.5 0.5 1.0"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="0.025 0.025 0.09"/>
        </geometry>
      </collision>
    </link>

    <!-- Attach camera mount bracket to Link_6 (on the cylinder surface) -->
    <!-- Yaw offset to match real mounting angle on flange -->
    <joint name="camera_mount_joint" type="fixed">
      <origin xyz="0 0 0" rpy="0 0 -2.26893"/>
      <parent link="Link_6"/>
      <child link="camera_mount_link"/>
    </joint>

    <!-- Attach camera body to mount (Z points toward gripper) -->
    <joint name="camera_joint" type="fixed">
      <origin xyz="0 -0.065 0.013" rpy="1.5708 0 -1.5708"/>
      <parent link="camera_mount_link"/>
      <child link="camera_link"/>
    </joint>

    <!-- Camera optical frames (required by RealSense ROS 2 driver) -->
    <!-- Depth optical frame: ROS convention X-right, Y-down, Z-forward -->
    <link name="camera_depth_frame"/>
    <joint name="camera_depth_joint" type="fixed">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <parent link="camera_link"/>
      <child link="camera_depth_frame"/>
    </joint>

    <link name="camera_depth_optical_frame"/>
    <joint name="camera_depth_optical_joint" type="fixed">
      <origin xyz="0 0 0" rpy="-1.5708 1.5708 0"/>
      <parent link="camera_depth_frame"/>
      <child link="camera_depth_optical_frame"/>
    </joint>

    <!-- Color optical frame (offset ~15mm from depth) -->
    <link name="camera_color_frame"/>
    <joint name="camera_color_joint" type="fixed">
      <origin xyz="0 0.015 0" rpy="0 0 0"/>
      <parent link="camera_link"/>
      <child link="camera_color_frame"/>
    </joint>

    <link name="camera_color_optical_frame"/>
    <joint name="camera_color_optical_joint" type="fixed">
      <origin xyz="0 0 0" rpy="-1.5708 0 0"/>
      <parent link="camera_color_frame"/>
      <child link="camera_color_optical_frame"/>
    </joint>

    <!-- ==================== OnRobot 2FG7 Gripper ==================== -->

    <!-- Gripper Base Link -->
    <link name="gripper_base_link">
      <inertial>
        <origin xyz="-4.899e-05 2.848e-06 0.06811" rpy="0 0 0"/>
        <mass value="1.2647"/>
        <inertia ixx="0.001504" iyy="0.001812" izz="0.001053" ixy="0.0" iyz="0.0" ixz="-3e-06"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://jaka_description/meshes/onrobot_2fg7_meshes/base_link.stl" scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="gripper_silver">
          <color rgba="0.700 0.700 0.700 1.000"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://jaka_description/meshes/onrobot_2fg7_meshes/base_link.stl" scale="0.001 0.001 0.001"/>
        </geometry>
      </collision>
    </link>

    <!-- Gripper Right Finger Link -->
    <link name="right_finger_link">
      <inertial>
        <origin xyz="0.01787 0.02949 0.01523" rpy="0 0 0"/>
        <mass value="0.02322"/>
        <inertia ixx="6e-06" iyy="5e-06" izz="2e-06" ixy="0.0" iyz="0.0" ixz="1e-06"/>
      </inertial>
      <visual>
        <origin xyz="0.054361 0.029494 -0.12005" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://jaka_description/meshes/onrobot_2fg7_meshes/right_finger_link.stl" scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="gripper_silver">
          <color rgba="0.700 0.700 0.700 1.000"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0.054361 0.029494 -0.12005" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://jaka_description/meshes/onrobot_2fg7_meshes/right_finger_link.stl" scale="0.001 0.001 0.001"/>
        </geometry>
      </collision>
    </link>

    <!-- Gripper Left Finger Link -->
    <link name="left_finger_link">
      <inertial>
        <origin xyz="0.00425 0.02950 0.01523" rpy="0 0 0"/>
        <mass value="0.02322"/>
        <inertia ixx="6e-06" iyy="5e-06" izz="2e-06" ixy="0.0" iyz="0.0" ixz="-1e-06"/>
      </inertial>
      <visual>
        <origin xyz="-0.032239 0.029494 -0.12005" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://jaka_description/meshes/onrobot_2fg7_meshes/left_finger_link.stl" scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="gripper_silver">
          <color rgba="0.700 0.700 0.700 1.000"/>
        </material>
      </visual>
      <collision>
        <origin xyz="-0.032239 0.029494 -0.12005" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://jaka_description/meshes/onrobot_2fg7_meshes/left_finger_link.stl" scale="0.001 0.001 0.001"/>
        </geometry>
      </collision>
    </link>

    <!-- Fixed joint: Attach gripper directly to Link_6 flange (no gap) -->
    <!-- Same yaw offset as camera mount to match real mounting angle -->
    <joint name="gripper_base_joint" type="fixed">
      <origin xyz="0 0 0" rpy="0 0 -2.26893"/>
      <parent link="Link_6"/>
      <child link="gripper_base_link"/>
    </joint>

    <!-- Left finger prismatic joint -->
    <joint name="left_finger_joint" type="prismatic">
      <origin xyz="0.032239 -0.029494 0.12005" rpy="0 0 0"/>
      <parent link="gripper_base_link"/>
      <child link="left_finger_link"/>
      <axis xyz="-1.0 0.0 0.0"/>
      <limit lower="0.0" upper="0.019" effort="140" velocity="0.45"/>
    </joint>

    <!-- Right finger prismatic joint (mimics left) -->
    <joint name="right_finger_joint" type="prismatic">
      <origin xyz="-0.054361 -0.029494 0.12005" rpy="0 0 0"/>
      <parent link="gripper_base_link"/>
      <child link="right_finger_link"/>
      <axis xyz="1.0 0.0 0.0"/>
      <limit lower="0.0" upper="0.019" effort="140" velocity="0.45"/>
      <mimic joint="left_finger_joint" multiplier="1.0"/>
    </joint>

    <!-- Dummy link and joint to absorb the bogus right_finger_joint_mimic published by ign_ros2_control -->
    <link name="right_finger_joint_mimic_dummy_link"/>
    <joint name="right_finger_joint_mimic" type="prismatic">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <parent link="gripper_base_link"/>
      <child link="right_finger_joint_mimic_dummy_link"/>
      <axis xyz="1 0 0"/>
      <limit lower="-1.0" upper="1.0" effort="0" velocity="0"/>
    </joint>

    <!-- Gripper Transmissions -->
    <transmission name="trans_left_finger_joint">
      <type>transmission_interface/SimpleTransmission</type>
      <joint name="left_finger_joint">
        <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
      </joint>
      <actuator name="left_finger_joint_motor">
        <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
        <mechanicalReduction>1</mechanicalReduction>
      </actuator>
    </transmission>

    <gazebo>
        <!-- <plugin name="gazebo_ros2_control" filename="libgazebo_ros2_control.so"> -->
        <plugin name="ign_ros2_control::IgnitionROS2ControlPlugin" filename="libign_ros2_control-system.so">
          <parameters>$(find jaka_zu5_moveit_config)/config/ros2_controllers.yaml</parameters>
          <robotNamespace>/</robotNamespace>
        </plugin>
    </gazebo>

    <!-- ==================== Gazebo Simulation: RGBD Camera Sensor ==================== -->
    <gazebo reference="camera_link">
      <sensor name="rgbd_camera" type="rgbd_camera">
        <!-- Rotate sensor so Ignition X-forward matches ROS optical Z-forward -->
        <pose>0 0 0 1.5708 0 1.5708</pose>
        <camera>
          <horizontal_fov>1.211</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>3.0</far>
          </clip>
          <depth_camera>
            <clip>
              <near>0.1</near>
              <far>3.0</far>
            </clip>
          </depth_camera>
        </camera>
        <always_on>1</always_on>
        <update_rate>15</update_rate>
        <visualize>true</visualize>
        <topic>/camera</topic>
        <gz_frame_id>camera_link_gz_sensor</gz_frame_id>
      </sensor>
    </gazebo>

</robot>